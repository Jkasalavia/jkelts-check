#!/usr/bin/env bash

set -u

TITLE="JKELTS CHECK"
WIDTH=64

color() {
  case "$1" in
    cyan) printf '\033[36m' ;;
    green) printf '\033[32m' ;;
    yellow) printf '\033[33m' ;;
    red) printf '\033[31m' ;;
    bold) printf '\033[1m' ;;
    reset) printf '\033[0m' ;;
  esac
}

line() {
  local text="${1:-}"
  local clr="${2:-}"
  [ -n "$clr" ] && color "$clr"
  printf '%s\n' "$text"
  [ -n "$clr" ] && color reset
}

center() {
  local text="$1"
  local len=${#text}
  if [ "$len" -ge "$WIDTH" ]; then
    printf '%s' "$text"
    return
  fi
  local pad=$(( (WIDTH - len) / 2 ))
  printf '%*s%s' "$pad" "" "$text"
}

title() {
  local text="$1"
  line "$(printf '=%.0s' $(seq 1 "$WIDTH"))" cyan
  line "$(center "$text")" cyan
  line "$(printf '=%.0s' $(seq 1 "$WIDTH"))" cyan
}

status() {
  local label="$1"
  local value="$2"
  local state="${3:-OK}"
  local clr="green"
  [ "$state" = "WARNING" ] && clr="yellow"
  [ "$state" = "CRITICAL" ] && clr="red"
  printf '%-26s : %-34s ' "$label" "$value"
  color "$clr"
  printf '[%s]\n' "$state"
  color reset
}

read_terminal() {
  local prompt="$1"
  local __resultvar="$2"
  local value=""

  if [ -r /dev/tty ]; then
    printf '%s' "$prompt" > /dev/tty
    IFS= read -r value < /dev/tty || value=""
  else
    printf '%s' "$prompt"
    IFS= read -r value || value=""
  fi

  eval "$__resultvar=\$value"
}

cmd_value() {
  "$@" 2>/dev/null | awk 'NF { print; exit }'
}

run_with_timeout() {
  local seconds="$1"
  shift

  if command -v perl >/dev/null 2>&1; then
    perl -e 'alarm shift; exec @ARGV' "$seconds" "$@" 2>/dev/null || true
  else
    "$@" 2>/dev/null || true
  fi
}

bytes_to_gb() {
  awk -v b="${1:-0}" 'BEGIN { printf "%.2f GB", b / 1024 / 1024 / 1024 }'
}

percent_used_status() {
  local used="$1"
  if [ "$used" -ge 90 ]; then
    printf 'CRITICAL'
  elif [ "$used" -ge 80 ]; then
    printf 'WARNING'
  else
    printf 'OK'
  fi
}

get_mac_device_type() {
  local model_name="$1"
  local model_id="$2"
  local combined
  combined="$(printf '%s %s' "$model_name" "$model_id" | tr '[:upper:]' '[:lower:]')"

  case "$combined" in
    *macbook*) printf 'MAC LAPTOP' ;;
    *imac*) printf 'MAC ALL-IN-ONE' ;;
    *macmini*|*mac\ mini*|*macstudio*|*mac\ studio*|*macpro*|*mac\ pro*) printf 'MAC DESKTOP' ;;
    *) printf 'MAC' ;;
  esac
}

get_cpu_temperature() {
  if ! command -v powermetrics >/dev/null 2>&1; then
    printf 'Unavailable|powermetrics not found'
    return
  fi

  if [ "$(id -u)" -ne 0 ]; then
    printf 'Unavailable|Run with sudo to allow powermetrics sensor access'
    return
  fi

  local output temp
  output="$(run_with_timeout 6 powermetrics --samplers smc -n 1 -i 1000)"
  temp="$(printf '%s\n' "$output" | awk '
    {
      line = tolower($0)
      if (line ~ /temperature/ && line ~ /(cpu|die|package|cluster|core|p-core|e-core)/) {
        if (match($0, /[0-9]+(\.[0-9]+)?[[:space:]]*C/)) {
          print substr($0, RSTART, RLENGTH)
          exit
        }
        if (match($0, /[0-9]+(\.[0-9]+)?/)) {
          print substr($0, RSTART, RLENGTH) " C"
          exit
        }
      }
    }
  ')"

  if [ -n "$temp" ]; then
    printf '%s|powermetrics smc' "$temp"
  else
    printf 'Unavailable|Apple Silicon did not expose numeric CPU temperature through powermetrics'
  fi
}

get_thermal_pressure() {
  local pressure output

  if command -v powermetrics >/dev/null 2>&1 && [ "$(id -u)" -eq 0 ]; then
    output="$(run_with_timeout 6 powermetrics --samplers thermal -n 1 -i 1000)"
    pressure="$(printf '%s\n' "$output" | awk -F': *' '
      {
        line = tolower($0)
        if (line ~ /thermal pressure|thermal level|pressure level/) {
          print $2
          exit
        }
      }
    ')"
  fi

  if [ -z "$pressure" ] && command -v pmset >/dev/null 2>&1; then
    output="$(pmset -g thermlog 2>/dev/null || true)"
    pressure="$(printf '%s\n' "$output" | awk -F'= *|: *' '
      {
        line = tolower($0)
        if (line ~ /thermal pressure|thermal level|cpu_speed_limit|cpu_scheduler_limit/) {
          print $NF
          exit
        }
      }
    ')"
  fi

  [ -n "$pressure" ] && printf '%s' "$pressure" || printf 'Unavailable'
}

show_system() {
  title "$TITLE"
  local computer user os model model_id serial device_type
  computer="$(scutil --get ComputerName 2>/dev/null || hostname)"
  user="$(whoami)"
  os="$(sw_vers -productName 2>/dev/null) $(sw_vers -productVersion 2>/dev/null)"
  model="$(cmd_value system_profiler SPHardwareDataType | sed 's/^[[:space:]]*Model Name: //')"
  model_id="$(sysctl -n hw.model 2>/dev/null || true)"
  [ -z "$model" ] && model="${model_id:-Unknown}"
  serial="$(system_profiler SPHardwareDataType 2>/dev/null | awk -F': ' '/Serial Number/ {print $2; exit}')"
  [ -z "$serial" ] && serial="Unavailable"
  device_type="$(get_mac_device_type "$model" "$model_id")"

  printf '%-26s : %s\n' "Computer" "$computer"
  printf '%-26s : %s\n' "User" "$user"
  printf '%-26s : %s\n' "Administrator" "$(id -Gn | grep -qw admin && echo YES || echo NO)"
  printf '%-26s : %s\n' "macOS" "$os"
  printf '%-26s : %s\n' "Device Type" "$device_type"
  printf '%-26s : %s\n' "Model" "$model"
  [ -n "$model_id" ] && printf '%-26s : %s\n' "Model Identifier" "$model_id"
  printf '%-26s : %s\n' "Serial Number" "$serial"
}

show_cpu() {
  title "CPU"
  local cpu cores temp_info temp temp_source thermal thermal_state
  cpu="$(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo Unknown)"
  cores="$(sysctl -n hw.ncpu 2>/dev/null || echo Unknown)"

  status "CPU Model" "$cpu" "OK"
  status "CPU Cores" "$cores" "OK"

  temp_info="$(get_cpu_temperature)"
  temp="${temp_info%%|*}"
  temp_source="${temp_info#*|}"
  thermal="$(get_thermal_pressure)"
  thermal_state="OK"
  case "$(printf '%s' "$thermal" | tr '[:upper:]' '[:lower:]')" in
    *warn*|*fair*|*serious*) thermal_state="WARNING" ;;
    *critical*|*trap*|*heavy*) thermal_state="CRITICAL" ;;
    unavailable) thermal_state="WARNING" ;;
  esac

  if [ "$temp" = "Unavailable" ]; then
    status "CPU Temperature" "Unavailable" "WARNING"
  else
    status "CPU Temperature" "$temp" "OK"
  fi
  status "CPU Temp Source" "$temp_source" "$([ "$temp" = "Unavailable" ] && echo WARNING || echo OK)"
  status "Thermal Pressure" "$thermal" "$thermal_state"
}

show_memory() {
  title "MEMORY"
  local total pagesize free inactive speculative used pct state pressure
  total="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
  pagesize="$(pagesize)"
  free="$(vm_stat | awk '/Pages free/ {gsub("\\.","",$3); print $3}')"
  inactive="$(vm_stat | awk '/Pages inactive/ {gsub("\\.","",$3); print $3}')"
  speculative="$(vm_stat | awk '/Pages speculative/ {gsub("\\.","",$3); print $3}')"
  free="${free:-0}"
  inactive="${inactive:-0}"
  speculative="${speculative:-0}"
  used=$(( total - ((free + inactive + speculative) * pagesize) ))
  [ "$used" -lt 0 ] && used=0
  pct="$(awk -v u="$used" -v t="$total" 'BEGIN { if (t > 0) printf "%.0f", (u / t) * 100; else print 0 }')"
  state="$(percent_used_status "$pct")"
  pressure="$(memory_pressure 2>/dev/null | awk -F': ' '/System-wide memory free percentage/ {print $2; exit}')"
  [ -z "$pressure" ] && pressure="Unavailable"

  status "Total Memory" "$(bytes_to_gb "$total")" "OK"
  status "Used Memory" "$(bytes_to_gb "$used") ($pct%)" "$state"
  status "Memory Pressure" "$pressure" "OK"
}

show_storage() {
  title "STORAGE"
  df -H / | awk 'NR==2 {print $2 "|" $3 "|" $4 "|" $5}' | while IFS='|' read -r size used avail pct; do
    local pctnum state
    pctnum="${pct%%%}"
    state="$(percent_used_status "$pctnum")"
    status "System Disk Size" "$size" "OK"
    status "System Disk Used" "$used ($pct)" "$state"
    status "System Disk Free" "$avail" "OK"
  done

  if command -v diskutil >/dev/null 2>&1; then
    local smart
    smart="$(diskutil info / 2>/dev/null | awk -F': *' '/SMART Status/ {print $2; exit}')"
    [ -z "$smart" ] && smart="Unavailable"
    case "$smart" in
      Verified) status "SMART Status" "$smart" "OK" ;;
      Unavailable) status "SMART Status" "$smart" "WARNING" ;;
      *) status "SMART Status" "$smart" "WARNING" ;;
    esac
  fi
}

show_network() {
  title "NETWORK"
  local service ip gateway dns internet
  service="$(route get default 2>/dev/null | awk '/interface:/ {print $2; exit}')"
  [ -z "$service" ] && service="Unavailable"
  ip="$(ipconfig getifaddr "$service" 2>/dev/null || true)"
  [ -z "$ip" ] && ip="Unavailable"
  gateway="$(route -n get default 2>/dev/null | awk '/gateway:/ {print $2; exit}')"
  [ -z "$gateway" ] && gateway="Unavailable"
  dns="$(scutil --dns 2>/dev/null | awk '/nameserver\[[0-9]+\]/ {print $3}' | sort -u | paste -sd ', ' -)"
  [ -z "$dns" ] && dns="Unavailable"
  if ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1; then internet="Reachable"; else internet="Unavailable"; fi

  status "Active Interface" "$service" "OK"
  status "IP Address" "$ip" "$([ "$ip" = "Unavailable" ] && echo WARNING || echo OK)"
  status "Default Gateway" "$gateway" "$([ "$gateway" = "Unavailable" ] && echo WARNING || echo OK)"
  status "DNS Servers" "$dns" "$([ "$dns" = "Unavailable" ] && echo WARNING || echo OK)"
  status "Internet Test" "$internet" "$([ "$internet" = "Reachable" ] && echo OK || echo WARNING)"
}

show_gpu() {
  title "GPU"
  local gpu vram
  gpu="$(system_profiler SPDisplaysDataType 2>/dev/null | awk -F': ' '/Chipset Model/ {print $2; exit}')"
  vram="$(system_profiler SPDisplaysDataType 2>/dev/null | awk -F': ' '/VRAM|Total Number of Cores/ {print $2; exit}')"
  [ -z "$gpu" ] && gpu="Unavailable"
  [ -z "$vram" ] && vram="Unavailable"
  status "GPU Model" "$gpu" "$([ "$gpu" = "Unavailable" ] && echo WARNING || echo OK)"
  status "GPU Detail" "$vram" "$([ "$vram" = "Unavailable" ] && echo WARNING || echo OK)"
}

show_battery() {
  title "BATTERY"
  if ! system_profiler SPPowerDataType 2>/dev/null | grep -q "Battery Information"; then
    status "Battery" "No battery detected" "OK"
    return
  fi

  local cycle condition capacity charging
  cycle="$(system_profiler SPPowerDataType 2>/dev/null | awk -F': ' '/Cycle Count/ {print $2; exit}')"
  condition="$(system_profiler SPPowerDataType 2>/dev/null | awk -F': ' '/Condition/ {print $2; exit}')"
  capacity="$(pmset -g batt 2>/dev/null | awk -F';' '/%/ {gsub(/^ +| +$/,"",$1); print $1; exit}')"
  charging="$(pmset -g batt 2>/dev/null | awk -F';' '/%/ {gsub(/^ +| +$/,"",$2); print $2; exit}')"
  [ -z "$cycle" ] && cycle="Unavailable"
  [ -z "$condition" ] && condition="Unavailable"
  [ -z "$capacity" ] && capacity="Unavailable"
  [ -z "$charging" ] && charging="Unavailable"

  status "Battery Charge" "$capacity; $charging" "OK"
  status "Cycle Count" "$cycle" "OK"
  case "$condition" in
    Normal) status "Battery Condition" "$condition" "OK" ;;
    Unavailable) status "Battery Condition" "$condition" "WARNING" ;;
    *) status "Battery Condition" "$condition" "WARNING" ;;
  esac
}

show_microsoft() {
  title "MICROSOFT / OUTLOOK"
  local office outlook profiles size
  office="$(ls /Applications 2>/dev/null | grep -E '^Microsoft (Word|Excel|PowerPoint|Outlook)\.app$' | paste -sd ', ' -)"
  [ -z "$office" ] && office="Not detected"
  if [ -d "/Applications/Microsoft Outlook.app" ]; then outlook="Installed"; else outlook="Not detected"; fi
  profiles="$HOME/Library/Group Containers/UBF8T346G9.Office/Outlook/Outlook 15 Profiles"
  if [ -d "$profiles" ]; then
    size="$(du -sh "$profiles" 2>/dev/null | awk '{print $1}')"
  else
    size="Unavailable"
  fi

  status "Microsoft Apps" "$office" "$([ "$office" = "Not detected" ] && echo WARNING || echo OK)"
  status "Outlook" "$outlook" "$([ "$outlook" = "Installed" ] && echo OK || echo WARNING)"
  status "Outlook Data Size" "$size" "$([ "$size" = "Unavailable" ] && echo WARNING || echo OK)"
  status "Activation" "Use Microsoft app account/licensing screen" "WARNING"
}

show_full() {
  clear
  show_system
  echo
  show_cpu
  echo
  show_memory
  echo
  show_storage
  echo
  show_network
  echo
  show_gpu
  echo
  show_battery
  echo
  show_microsoft
}

menu() {
  clear
  title "$TITLE"
  line "Choose what to check:"
  line "1. CPU health"
  line "2. Memory health"
  line "3. Storage / disk health"
  line "4. Network health"
  line "5. GPU health"
  line "6. Battery health"
  line "7. Microsoft / Outlook health"
  line "8. System information"
  line "9. Full health check"
  line "0. Exit"
}

run_choice() {
  case "$1" in
    1) clear; show_system; echo; show_cpu ;;
    2) clear; show_memory ;;
    3) clear; show_storage ;;
    4) clear; show_network ;;
    5) clear; show_gpu ;;
    6) clear; show_battery ;;
    7) clear; show_microsoft ;;
    8) clear; show_system ;;
    9) show_full ;;
    0) line "Exiting."; exit 0 ;;
    *) line "Invalid choice: $1" red ;;
  esac
}

if [ "${1:-}" = "--choice" ] && [ -n "${2:-}" ]; then
  run_choice "$2"
  exit 0
fi

while true; do
  menu
  read_terminal 'Enter choice: ' choice
  run_choice "$choice"
  [ "$choice" = "0" ] && break
  echo
  read_terminal 'Press Enter to return to the menu' _
done
